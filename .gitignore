*.wav
assets/

# --- Web app (bun frontend + FastAPI backend) ---
web/backend/.venv/
web/backend/openapi.json          # regenerated from the Pydantic models (`just gen`)
web/frontend/node_modules/
web/frontend/dist/
web/frontend/src/api/generated/   # orval output (regenerate with `just gen`)
web/frontend/src/api/zod/

# --- Recorded vocal takes + their mixes (user uploads, purge via `just takes-clean`) ---
web/backend/takes/
takes/

# --- Session state / assistant scratch (not part of the project) ---
.remember/
memory/
